{
  "name": "trucktalk-v2",
  "private": true,
  "version": "2.0.0",
  "description": "TruckTalk: English for truck drivers working in the USA (rebuilt).",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node server.mjs --demo",
    "start": "node server.mjs",
    "build:content": "node scripts/build-content.mjs",
    "check": "node scripts/build-content.mjs --check && node scripts/check.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "e2e": "node e2e/run.mjs",
    "marketing": "node scripts/gen-marketing.mjs",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  }
}
