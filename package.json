{
  "name": "trucktalk-v2",
  "private": true,
  "version": "2.0.0",
  "description": "TruckTalk: English for truck drivers working in the USA (rebuilt).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "DEMO_MODE=1 node server.mjs",
    "start": "node server.mjs",
