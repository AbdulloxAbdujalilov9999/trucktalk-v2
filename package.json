    "test": "node --test \"tests/*.test.mjs\"",
    "e2e": "node e2e/run.mjs",
    "marketing": "node scripts/gen-marketing.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  }
}
