# TruckTalk environment variables. Copy the ones you need into Vercel (Project → Settings → Environment Variables)
# or Render. Never commit real values. docs/SETUP.md explains where each one comes from.
#
# Nothing is required to try the app locally: `npm run dev` runs demo mode with pretend sign-in and payments.

# --- Demo mode (local only) -------------------------------------------------------------------------------------
# DEMO_MODE=1 runs everything in memory/a local file. It switches itself off whenever FIREBASE_SERVICE_ACCOUNT is set,
# so a real deploy can never fall into it. Do not set DEMO_MODE on a real deploy.
DEMO_MODE=
DEMO_DB_FILE=

# --- Required in production ---------------------------------------------------------------------------------------
# Public address of the app, no trailing slash. Used in payment return links, Telegram links and emails.
APP_URL=https://your-domain.example
# 32+ random characters (openssl rand -hex 32). Signs Telegram sign-in and account-linking links.
SESSION_SECRET=

# Firebase: the service account JSON (Project settings → Service accounts → Generate new private key), pasted as-is
# or base64-encoded. Server-only. The browser never talks to the database directly.
FIREBASE_SERVICE_ACCOUNT=
# Realtime Database URL, e.g. https://your-project-default-rtdb.firebaseio.com (or the europe-west1 address).
FIREBASE_DATABASE_URL=
# Firebase web app config for sign-in (Project settings → Your apps → Web app). Not secret.
# Either the whole object as JSON in FIREBASE_WEB_CONFIG, or the separate fields below.
FIREBASE_WEB_CONFIG=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Optional: only if it differs from the service account's project.
FIREBASE_PROJECT_ID=

# Emails that are always admins (comma separated). Only verified Google / email-link sign-ins count.
ADMIN_EMAILS=

# --- Payments (Whop) ------------------------------------------------------------------------------------------------
# API key (Whop dashboard → Developer) and the webhook secret shown when you add the webhook
# <APP_URL>/api/webhooks?src=whop with these events: payment.succeeded, payment.refunded, refund.created, refund.updated,
# dispute.created, dispute.updated, membership.activated.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# One Whop plan per app plan (one-time payments). Only payments for these plan ids ever grant access.
WHOP_PLAN_SELF_MONTH=
WHOP_PLAN_SELF_QUARTER=
WHOP_PLAN_PRO_MONTH=
WHOP_PLAN_PRO_QUARTER=
# Optional: shown on the pricing page as a second way to pay (card transfer, Click/Payme...). An admin then grants the
# plan by hand from /admin. Example: "Click / Payme: +998 90 000 00 00 (Ism Familiya). Chekni @support ga yuboring."
MANUAL_PAYMENT_INFO=
# Optional: Telegram username for support (without @), linked from pricing and profile.
SUPPORT_TELEGRAM=

# --- AI teacher (Claude) ----------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5, fast and cheap for short corrections).
TUTOR_MODEL=
# Optional: all students together, AI checks per day (default 3000). Per-plan limits are in public/js/shared/plans.js.
AI_DAILY_LIMIT=

# --- Natural voice and the live voice teacher (ElevenLabs) -------------------------------------------------------
ELEVENLABS_API_KEY=
# The voice teacher agent's id (create it from elevenlabs/teacher.agent.json; keep "enable_auth": true).
ELEVENLABS_AGENT_ID=
# Optional voice/model overrides for lesson audio.
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_MODEL=
ELEVENLABS_UZ_VOICE=
ELEVENLABS_UZ_MODEL=
# Optional daily budgets for everyone together: characters of new lesson audio (default 60000) and voice-teacher
# minutes (default 240).
TTS_DAILY_CHARS=
VOICE_DAILY_MINUTES=
# Optional fallback for English lesson audio if you have no ElevenLabs key.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
OPENAI_VOICE_MALE=
OPENAI_VOICE_FEMALE=

# --- Telegram bot ---------------------------------------------------------------------------------------------------
# From @BotFather. After deploying, run scripts/telegram-setup.mjs once to connect the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 32+ random letters/digits (openssl rand -hex 32). Telegram sends it back with every update.
TELEGRAM_WEBHOOK_SECRET=

# --- Hosting ----------------------------------------------------------------------------------------------------------
# Render sets RENDER and PORT itself. FORCE_HSTS=1 sends the HSTS header from server.mjs on other https hosts.
PORT=
FORCE_HSTS=
